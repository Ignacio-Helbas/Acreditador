rules_version = '2';

// ===============================================================
// Modelo de Datos Asumido (Assumed Data Model)
// ===============================================================
//
// Este archivo de reglas de seguridad Cloud Firestore rige la plataforma
// de acreditación de eventos en tiempo real 'acreditador-utn-frsr'.
//
// 1. Colección Raíz: admins/{email}
//    Document ID: Dirección de email en minúsculas (ej: 'ignacio@gmail.com', 1..100 caracteres).
//    Campos:
//      - email: string (obligatorio, 1..100 caracteres) - Email del administrador, debe coincidir con el ID del documento.
//      - role: string (obligatorio, 1..30 caracteres, ej: 'admin') - Rol administrativo asignado.
//      - active: bool (obligatorio) - Bandera que habilita o deshabilita los privilegios del administrador.
//      - createdAt: timestamp (opcional) - Fecha/hora del servidor en que se dio de alta al administrador.
//      - note: string (opcional, hasta 500 caracteres) - Observación interna opcional.
//
// 2. Colección Raíz: events/{eventId}
//    Document ID: Identificador del evento (ej: 'main-event', 1..64 caracteres).
//    Campos:
//      - name: string (opcional, 1..150 caracteres) - Nombre o título del evento.
//      - logo: string | null (opcional, hasta 500.000 caracteres) - Data URL o URL del logo del evento.
//      - config: map (opcional, hasta 50 claves) - Configuración general (columnas visibles, etiquetas, etc.).
//      - lastUpdated: string (opcional, hasta 50 caracteres) - Marca temporal ISO de última sincronización.
//      - lastSyncSource: string (opcional, hasta 50 caracteres) - Origen de datos ('excel', 'google-sheets', etc.).
//      - totalAttendees: int (opcional, >= 0 y <= 1.000.000) - Total de asistentes en la nómina.
//      - updatedAt: timestamp (opcional) - Timestamp de actualización en Firestore.
//      - createdAt: timestamp (opcional) - Timestamp de creación del evento.
//
// 3. Subcolección: events/{eventId}/attendees/{dni}
//    Document ID: DNI o documento normalizado del asistente (ej: '38123456', 1..40 caracteres).
//    Campos:
//      - dni: string (obligatorio, 1..40 caracteres) - DNI del asistente, debe coincidir con el ID del documento.
//      - acreditado: bool (obligatorio) - Estado actual de acreditación (true: ingresó, false: pendiente).
//      - fechaAcreditacion: string | null (opcional, hasta 50 caracteres) - Momento exacto del ingreso (ISO 8601).
//      - operador: string | null (opcional, hasta 120 caracteres) - Nombre o terminal que realizó la acreditación.
//      - puntoAcceso: string | null (opcional, hasta 100 caracteres) - Puerta o terminal de ingreso.
//      - updatedAt: timestamp (opcional) - Timestamp de última modificación.
//      - createdAt: timestamp (opcional) - Timestamp de creación inicial del registro.
//      - nombre: string (opcional, hasta 120 caracteres) - Nombre de pila. Inmutable para operadores.
//      - apellido: string (opcional, hasta 120 caracteres) - Apellido. Inmutable para operadores.
//      - nombreCompleto: string (opcional, hasta 240 caracteres) - Nombre completo para visualización. Inmutable para operadores.
//      - dynamicFields: map (opcional, hasta 50 entradas) - Campos personalizados importados (empresa, mesa, etc.). Inmutable para operadores.
//      - id: string (opcional, hasta 50 caracteres) - Identificador interno opcional.
//      - rawRow: map (opcional, hasta 50 entradas) - Fila cruda importada. Inmutable para operadores.
//
// 4. Subcolección: events/{eventId}/activity_feed/{feedId}
//    Document ID: ID generado automáticamente (auto-ID, 1..64 caracteres).
//    Campos:
//      - dni: string (obligatorio, 1..40 caracteres) - DNI del asistente vinculado a la acción.
//      - action: string (obligatorio, valores permitidos: 'ACCREDIT' o 'UNDO') - Tipo de acción.
//      - operador: string (obligatorio, 1..120 caracteres) - Operador o terminal responsable.
//      - puntoAcceso: string (obligatorio, 1..100 caracteres) - Puerta o punto de acceso.
//      - timestamp: string (obligatorio, 1..50 caracteres) - Timestamp ISO de la acción para ordenamiento.
//      - nombre: string (opcional, hasta 120 caracteres) - Nombre del asistente.
//      - apellido: string (opcional, hasta 120 caracteres) - Apellido del asistente.
//      - createdAt: timestamp (opcional) - Timestamp de servidor.
//    Invariante: Colección append-only (solo creación; actualización y borrado estrictamente prohibidos).
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Denegación por Defecto (Default Deny)
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Funciones Auxiliares Generales (Helpers)
    // ===============================================================

    // Verifica si la solicitud proviene de un usuario autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verifica si el usuario actual posee credenciales de Administrador activo en /admins/{email}
    // Requiere usuario autenticado, email en token, existencia del documento y flag active == true
    function isAdmin() {
      return request.auth != null && 
        request.auth.token.email != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email.toLower())) &&
        get(/databases/$(database)/documents/admins/$(request.auth.token.email.toLower())).data.active == true;
    }

    // Valida que el documento entrante contenga únicamente las claves permitidas en el esquema
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Valida que el documento entrante contenga todas las claves requeridas
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Valida que los campos inmutables especificados no hayan sido modificados durante la actualización
    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ===============================================================
    // Validadores de Dominio (Domain Validators)
    // ===============================================================

    // Validador de Administrador (admins/{email})
    function isValidAdmin(data, docEmail) {
      let allowedKeys = ['email', 'role', 'active', 'createdAt', 'note'];
      let requiredKeys = ['email', 'role', 'active'];

      return hasOnlyAllowedFields(allowedKeys) &&
        hasRequiredFields(requiredKeys) &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 100 &&
        data.email.toLower() == docEmail.toLower() &&
        data.role is string && data.role.size() > 0 && data.role.size() <= 30 &&
        data.active is bool &&
        (!('createdAt' in data) || data.createdAt is timestamp) &&
        (!('note' in data) || (data.note is string && data.note.size() <= 500));
    }

    // Validador de Evento (events/{eventId})
    function isValidEvent(data) {
      let allowedKeys = [
        'name', 'logo', 'config', 'lastUpdated', 
        'lastSyncSource', 'totalAttendees', 'updatedAt', 'createdAt'
      ];

      return hasOnlyAllowedFields(allowedKeys) &&
        (!('name' in data) || (data.name is string && data.name.size() > 0 && data.name.size() <= 150)) &&
        (!('logo' in data) || data.logo == null || (data.logo is string && data.logo.size() <= 500000)) &&
        (!('config' in data) || (data.config is map && data.config.size() <= 50)) &&
        (!('lastUpdated' in data) || (data.lastUpdated is string && data.lastUpdated.size() <= 50)) &&
        (!('lastSyncSource' in data) || (data.lastSyncSource is string && data.lastSyncSource.size() <= 50)) &&
        (!('totalAttendees' in data) || (data.totalAttendees is int && data.totalAttendees >= 0 && data.totalAttendees <= 1000000)) &&
        (!('updatedAt' in data) || data.updatedAt is timestamp) &&
        (!('createdAt' in data) || data.createdAt is timestamp);
    }

    // Validador de Asistente (events/{eventId}/attendees/{dni})
    function isValidAttendee(data, docDni) {
      let allowedKeys = [
        'dni', 'nombre', 'apellido', 'nombreCompleto', 'dynamicFields',
        'acreditado', 'fechaAcreditacion', 'operador', 'puntoAcceso',
        'updatedAt', 'createdAt', 'id', 'rawRow'
      ];

      return hasOnlyAllowedFields(allowedKeys) &&
        hasRequiredFields(['dni', 'acreditado']) &&
        data.dni is string && data.dni.size() > 0 && data.dni.size() <= 40 &&
        data.dni.toLower() == docDni.toLower() &&
        data.acreditado is bool &&
        (!('nombre' in data) || (data.nombre is string && data.nombre.size() <= 120)) &&
        (!('apellido' in data) || (data.apellido is string && data.apellido.size() <= 120)) &&
        (!('nombreCompleto' in data) || (data.nombreCompleto is string && data.nombreCompleto.size() <= 240)) &&
        (!('dynamicFields' in data) || (data.dynamicFields is map && data.dynamicFields.size() <= 50)) &&
        (!('fechaAcreditacion' in data) || data.fechaAcreditacion == null || (data.fechaAcreditacion is string && data.fechaAcreditacion.size() <= 50)) &&
        (!('operador' in data) || data.operador == null || (data.operador is string && data.operador.size() <= 120)) &&
        (!('puntoAcceso' in data) || data.puntoAcceso == null || (data.puntoAcceso is string && data.puntoAcceso.size() <= 100)) &&
        (!('updatedAt' in data) || data.updatedAt is timestamp) &&
        (!('createdAt' in data) || data.createdAt is timestamp) &&
        (!('id' in data) || (data.id is string && data.id.size() <= 50)) &&
        (!('rawRow' in data) || (data.rawRow is map && data.rawRow.size() <= 50));
    }

    // Valida que los operadores (públicos o anónimos) solo alteren los campos estrictamente permitidos de acreditación
    // Prohíbe terminantemente la alteración de datos identitarios (dni, nombre, apellido, dynamicFields, createdAt, etc.)
    function isAllowedOperatorAttendeeUpdate() {
      let allowedChangedKeys = ['acreditado', 'fechaAcreditacion', 'operador', 'puntoAcceso', 'updatedAt'];
      let prohibitedKeys = ['dni', 'nombre', 'apellido', 'nombreCompleto', 'dynamicFields', 'createdAt', 'id', 'rawRow'];

      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedChangedKeys) &&
        areImmutableFieldsUnchanged(prohibitedKeys) &&
        request.resource.data.dni == resource.data.dni;
    }

    // Validador de Eventos en el Feed de Actividad (events/{eventId}/activity_feed/{feedId})
    function isValidActivityFeed(data) {
      let allowedKeys = [
        'dni', 'action', 'operador', 'puntoAcceso', 'timestamp',
        'nombre', 'apellido', 'createdAt'
      ];
      let requiredKeys = ['dni', 'action', 'operador', 'puntoAcceso', 'timestamp'];

      return hasOnlyAllowedFields(allowedKeys) &&
        hasRequiredFields(requiredKeys) &&
        data.dni is string && data.dni.size() > 0 && data.dni.size() <= 40 &&
        data.action is string && data.action in ['ACCREDIT', 'UNDO'] &&
        data.operador is string && data.operador.size() > 0 && data.operador.size() <= 120 &&
        data.puntoAcceso is string && data.puntoAcceso.size() > 0 && data.puntoAcceso.size() <= 100 &&
        data.timestamp is string && data.timestamp.size() > 0 && data.timestamp.size() <= 50 &&
        (!('nombre' in data) || (data.nombre is string && data.nombre.size() <= 120)) &&
        (!('apellido' in data) || (data.apellido is string && data.apellido.size() <= 120)) &&
        (!('createdAt' in data) || data.createdAt is timestamp);
    }

    // ===============================================================
    // 1. Colección Raíz: admins/{email}
    // ===============================================================
    match /admins/{email} {
      // Lectura individual (get):
      // - Cualquier usuario autenticado puede leer su propio documento para verificar si es admin
      // - Un administrador existente activo puede leer cualquier documento de administrador
      allow get: if (
        request.auth != null &&
        request.auth.token.email != null &&
        request.auth.token.email.toLower() == email.toLower()
      ) || isAdmin();

      // Listado de administradores (list):
      // Exclusivamente reservado a Administradores existentes activos (ej: pantalla de gestión de administradores)
      allow list: if isAdmin();

      // Escritura (create, update, delete):
      // Estrictamente reservada a Administradores existentes activos
      allow create: if isAdmin() && isValidAdmin(request.resource.data, email);
      allow update: if isAdmin() &&
                       isValidAdmin(request.resource.data, email) &&
                       request.resource.data.email == resource.data.email &&
                       (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if isAdmin();
    }

    // ===============================================================
    // 2. Colección Raíz: events/{eventId}
    // ===============================================================
    match /events/{eventId} {
      // Lectura: Permitida para todos (pública / operadores en terminales / admins)
      allow read: if true;

      // Escritura (create, update, delete): Estrictamente reservada a Administradores
      allow create: if isAdmin() && isValidEvent(request.resource.data);
      allow update: if isAdmin() && isValidEvent(request.resource.data) &&
                       (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if isAdmin();

      // =============================================================
      // 3. Subcolección: attendees/{dni} (Asistentes al Evento)
      // =============================================================
      match /attendees/{dni} {
        // Lectura: Permitida para operadores (públicos / anónimos en terminales de puerta) y administradores
        allow read: if true;

        // Creación y borrado: Estrictamente reservado a Administradores (cargas de nómina / depuración)
        allow create: if isAdmin() && isValidAttendee(request.resource.data, dni);
        allow delete: if isAdmin();

        // Actualización:
        // - Administradores (isAdmin()): pueden actualizar cualquier campo válido, respetando la inmutabilidad de DNI y createdAt.
        // - Operadores públicos o anónimos: ÚNICAMENTE pueden actualizar los campos de acreditación
        //   (acreditado, fechaAcreditacion, operador, puntoAcceso, updatedAt).
        //   Tienen estrictamente prohibido alterar dni, nombre, apellido, nombreCompleto, dynamicFields o createdAt.
        allow update: if (
          isAdmin() &&
          isValidAttendee(request.resource.data, dni) &&
          request.resource.data.dni == resource.data.dni &&
          (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
        ) || (
          isAllowedOperatorAttendeeUpdate() &&
          isValidAttendee(request.resource.data, dni)
        );
      }

      // =============================================================
      // 4. Subcolección: activity_feed/{feedId} (Feed de Actividad)
      // =============================================================
      match /activity_feed/{feedId} {
        // Lectura: Permitida para monitoreo en vivo (panel de administración y terminales)
        allow read: if true;

        // Creación: Permitida para registrar eventos de acreditación/desacreditación con validación estricta de esquema
        allow create: if isValidActivityFeed(request.resource.data);

        // Actualización y borrado: Estrictamente PROHIBIDOS (colección de auditoría append-only)
        allow update, delete: if false;
      }
    }
  }
}
